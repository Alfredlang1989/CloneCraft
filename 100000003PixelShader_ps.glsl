				shadowMapTexSize /= maxUV.x - minUV.x;
			
			return ( ( 1.0f - tmpNdotL ) * normalOffsetBias * float3( geomNormal.xyz ) * shadowMapTexSize );
		}
	
	
		INLINE midf getShadow( sampler2DShadow shadowMap, 
