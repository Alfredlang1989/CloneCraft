# Build output
build/
build-*/
cmake-build-*/

# Object / library artifacts
*.o
*.obj
*.so
*.so.*
*.dll
*.a
*.lib
*.exe

# IDE / editor files
.vscode/
.idea/
*.swp
*.sln
*.vcxproj*
compile_commands.json
.cache/

# Logs and runtime cache
*.log
cache/

# Generated world / save data
worlddata/
saves/

# OS files
.DS_Store
Thumbs.db
# Static analyzer output
*.plist

# Python helper cache
__pycache__/
*.pyc

# Project agent harness is tracked; only generated local state is ignored
.opencode/node_modules/
.opencode/.cache/
.claude/
graphify-out/

# OgreNext GLSL shader-cache files written into the working directory at runtime
/[0-9]*PixelShader_ps.glsl
/[0-9]*VertexShader_vs.glsl
